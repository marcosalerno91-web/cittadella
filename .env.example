# --- Supabase (produzione e staging) ---
# Quando queste tre variabili sono presenti, l'app usa Supabase (Postgres + Auth + RLS).
# Quando NON sono presenti, l'app parte in modalita' sviluppo locale con driver su file
# (vedi DECISIONI.md, decisione D1) e non serve alcun servizio esterno.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usata solo dagli script di amministrazione (creazione agenzia + primo advisor).
# NON deve mai finire in un bundle client. Non impostarla su Vercel se non serve.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sviluppo locale ---
# Cartella dove il driver locale salva i dati (default: .data)
CITTADELLA_LOCAL_DATA_DIR=.data
